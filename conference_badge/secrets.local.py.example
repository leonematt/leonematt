# Copy to secrets.local.py (git-ignored) and fill in. build_uf2.py puts it on
# the badge as secrets.py, so your WiFi details never land in drive/ or git.
WIFI_SSID = "your-network"
WIFI_PASSWORD = "your-password"
REGION = "us"  # Options are us, cuba, eu, moldova, lebanon, egypt, chile, australia, nz
TIMEZONE = -8  # Standard-time offset from GMT in hours; REGION handles daylight saving
